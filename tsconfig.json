{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "preserve",
		"incremental": true,
                "plugins": [
                        {
                                "name": "next"
                        }
                ],
                "paths": {
                        "@/*": ["./*"],
                        "qrcode": ["./lib/vendor/qrcode-shim"],
                        "re-resizable": ["./lib/vendor/re-resizable"]
                }
        },
        "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", "types/**/*.d.ts", ".next/types/**/*.ts"],
        "exclude": [
                "node_modules",
                "custom-worker.ts",
                ".open-next/**/*",
                "worker/**/*",
                "patch_broken/**/*",
                "scripts/public-export/template/**/*",
                "tests/**/*"
        ]
}
