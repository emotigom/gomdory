{
  "name": "gomdory",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "next dev --turbo",
    "lint": "eslint app lib --max-warnings=0",
    "check:design": "node scripts/check-design.mjs",
    "check:boardid": "node ./scripts/check-board-id-contract.mjs",
    "check:parse": "node scripts/ci/parsecheck.mjs",
    "check:silent-return": "node ./scripts/check-silent-return.mjs",
    "check:supabase:migrations": "node ./scripts/check-supabase-migrations.mjs",
    "check:supabase:migrations:update-baseline": "node ./scripts/check-supabase-migrations.mjs --update-baseline",
    "test:check:supabase:migrations": "node ./scripts/check-supabase-migrations.mjs --self-test",
    "audit:duplication": "node scripts/duplication/scan.mjs",
    "audit:selfcheck": "node scripts/selfcheck/scan.mjs",
    "audit:contract": "node scripts/contracts/generate.mjs",
    "audit:routes:plan": "node scripts/selfcheck/report-top.mjs",
    "check:duplication": "node scripts/duplication/check.mjs",
    "check:contract": "node scripts/contracts/check.mjs",
    "check:contract:update-baseline": "node scripts/contracts/check.mjs --update-baseline",
    "check:contract:strict": "node scripts/contracts/check.mjs --fail-on-new-missing",
    "check:selfcheck": "node scripts/selfcheck/check.mjs",
    "check:page-links": "node scripts/selfcheck/check-page-links.mjs",
    "gen:page-routes": "node scripts/selfcheck/gen-page-route-inventory.mjs",
    "check:selfcheck:update-baseline": "node scripts/selfcheck/check.mjs --update-baseline",
    "ssot:check": "node ./scripts/ssot/check.mjs",
    "check:security": "npm run check:security:full",
    "check:security:fast": "npm run check:parse && npm run check:supabase:migrations && npm run check:security:client-supabase",
    "check:security:full": "npm run check:security:fast && npm run check:duplication && npm run check:selfcheck && npm run check:page-links && npm run check:contract && npm run check:codemod",
    "check:security:client-supabase": "node scripts/security/check-client-supabase-access.mjs",
    "lint:update-baseline:api-v1": "node scripts/eslint/update-no-hardcoded-api-v1-baseline.mjs",
    "lint:strict": "STRICT_API_PATH_LINT=1 npm run lint",
    "preinstall": "node scripts/check-node-version.mjs",
    "check:codemod": "node scripts/codemod/wrap-api-v1.mjs --check && node scripts/codemod/unsafe-to-routes.mjs --check",
    "check:codemod:manual": "npm run check:codemod",
    "check:ui": "node scripts/smoke-check-ui.mjs",
    "check:edu-ui": "node scripts/smoke-edu-ui.mjs",
    "check:edu:runtime": "node scripts/edu/check-runtime-endpoints.mjs",
    "check:edu:routes": "node scripts/edu/check-route-shape.mjs",
    "codemod:wrap-api-v1:dry": "node scripts/codemod/wrap-api-v1.mjs --dry-run",
    "codemod:wrap-api-v1": "node scripts/codemod/wrap-api-v1.mjs --apply",
    "codemod:wrap-api-v1:app": "node scripts/codemod/wrap-api-v1.mjs --apply --include app/",
    "codemod:wrap-api-v1:lib": "node scripts/codemod/wrap-api-v1.mjs --apply --include lib/",
    "codemod:unsafe-to-routes:dry": "node scripts/codemod/unsafe-to-routes.mjs --dry-run",
    "codemod:unsafe-to-routes": "node scripts/codemod/unsafe-to-routes.mjs --apply",
    "selfcheck:fix:dry": "node scripts/selfcheck/apply-fixes.mjs --dry-run",
    "selfcheck:fix": "node scripts/selfcheck/apply-fixes.mjs --apply",
    "selfcheck:comment": "node scripts/selfcheck/comment.mjs",
    "selfcheck:probe": "node scripts/selfcheck/probe.mjs",
    "selfcheck:probe:pages": "node scripts/selfcheck/probe.mjs --pages",
    "selfcheck:probe:assets": "node scripts/selfcheck/probe.mjs --pages --assets --json-summary",
    "check:probe": "node scripts/selfcheck/probe.mjs --pages --assets --contract-hash",
    "check:probe:update-contract-hash": "node scripts/selfcheck/probe.mjs --pages --assets --contract-hash --update-contract-hash-baseline",
    "selfcheck": "npm run check:supabase:migrations && npm run check:duplication && npm run check:selfcheck && npm run selfcheck:probe -- --summary",
    "start": "next start",
    "build": "npm run build:verified",
    "build:verified": "npm run lint && npm run check:route-invariants && npm run typecheck && npm run test:public && npm run build:opennext:public",
    "test": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs",
    "build:next": "node ./scripts/with-ci.mjs npm run gen:page-routes && next build",
    "build:opennext:prod": "node ./scripts/with-ci.mjs npm run build:next && node ./scripts/with-ci.mjs opennextjs-cloudflare build -c wrangler.jsonc --skipNextBuild && node ./scripts/ensure-build-id-asset.mjs",
    "build:opennext:preview": "bash scripts/deploy-timing.sh build:opennext:preview -- bash -c 'node ./scripts/with-ci.mjs npm run build:next && node ./scripts/with-ci.mjs opennextjs-cloudflare build -c wrangler.jsonc -e preview --skipNextBuild && node ./scripts/ensure-build-id-asset.mjs'",
    "clean:next-cache": "node -e \"require('fs').rmSync('.next/cache',{ recursive: true, force: true })\"",
    "build:opennext:clean": "npm run clean:next-cache && npm run build:opennext:prod",
    "check:release:full": "npm run check:security:full",
    "test:browser:foundation": "node scripts/qa/q2-browser-foundation.mjs",
    "test:browser:j2-entry": "node scripts/qa/q2-b4-student-entry.mjs",
    "check:lock": "node ./scripts/with-ci.mjs npm ci --include=optional --no-audit --progress=false && git diff --exit-code package-lock.json",
    "doctor": "node scripts/doctor.mjs --quick",
    "doctor:full": "node scripts/doctor.mjs --full",
    "doctor:json": "node scripts/doctor.mjs --quick --json",
    "ssot:test": "node --test ./scripts/ssot/env.contract.test.mjs",
    "check:route-invariants": "node scripts/guard/route-invariants.mjs",
    "check:edu:asset-validator": "node scripts/ci/check-webllm-asset-validator.mjs",
    "typecheck": "tsc --noEmit",
    "check:api-keys": "node scripts/check-api-keys.mjs",
    "check:no-hardcoded": "node scripts/guard/no-hardcoded.mjs",
    "ci:preflight": "npm run lint && npm run typecheck && npm run ssot:check && npm run check:api-dto && npm run check:hardcoded",
    "validate:pr": "npm run ci:preflight",
    "validate:seams": "npm run docs:check && npm run check:route-invariants && npm run test:guards",
    "check:api-dto": "node scripts/check-api-keys.mjs",
    "check:hardcoded": "node scripts/guard/no-hardcoded.mjs",
    "test:smoke:edu:lesson:public": "node ./scripts/smoke-edu-lesson-public.mjs",
    "check:webllm:env": "node scripts/ci/check-webllm-env.mjs",
    "ci:fix-guidance": "node scripts/ci/fix-guidance.mjs",
    "check:buildlog": "node scripts/ci/parse-build-log.mjs",
    "test:smoke:node": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group smoke-contract",
    "test:node": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group node",
    "test:ui": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group ui",
    "test:guards": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group guards",
    "test:source": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group source",
    "check:qa:test-manifest": "node scripts/qa/check-test-manifest.mjs",
    "docs:linkcheck": "node vendor/docs-link-checker/bin/check.mjs docs",
    "docs:check": "npm run docs:linkcheck && npm run check:context-boundary",
    "check:model-cors": "node scripts/selfcheck/check-model-cors.mjs",
    "audit:public": "node scripts/audit-public-html-guards.mjs",
    "check:hud-assets": "node scripts/check-hud-assets.mjs",
    "test:webllm": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group webllm",
    "check:webllm:gomdory-hosting": "node scripts/check-webllm-gomdory-hosting.mjs",
    "test:website-studio": "node scripts/run-website-studio-tests.mjs",
    "check:context-boundary": "node scripts/guard/check-context-boundary.mjs",
    "build:opennext:public": "node ./scripts/with-ci.mjs npm run build:next && node ./scripts/with-ci.mjs opennextjs-cloudflare build -c wrangler.public-ci.jsonc --skipNextBuild && node ./scripts/ensure-build-id-asset.mjs",
    "test:public": "cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group node && cross-env TEST_NETWORK_GUARD=1 node scripts/run-tests.mjs --group guards"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.0",
    "@dnd-kit/modifiers": "^7.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@mlc-ai/web-llm": "^0.2.80",
    "@opennextjs/cloudflare": "^1.14.4",
    "@react-three/drei": "file:vendor/react-three-drei",
    "@react-three/fiber": "file:vendor/react-three-fiber",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.48.0",
    "aws4fetch": "^1.0.18",
    "exceljs": "4.4.0",
    "fflate": "^0.8.2",
    "next": "15.5.9",
    "qrcode": "^1.5.4",
    "react": "19.1.4",
    "react-dom": "19.1.4",
    "simple-peer": "file:vendor/simple-peer",
    "three": "file:vendor/three",
    "zod": "^3.22.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@gom-clean/docs-link-checker": "file:vendor/docs-link-checker",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^20.19.6",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "cross-env": "file:vendor/cross-env",
    "eslint": "^9.39.2",
    "eslint-config-next": "15.5.9",
    "jsdom": "file:vendor/jsdom",
    "supabase": "2.109.1",
    "tailwindcss": "^4.1.18",
    "ts-morph": "^25.0.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.56.0"
  },
  "license": "UNLICENSED"
}
